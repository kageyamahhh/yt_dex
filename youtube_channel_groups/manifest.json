{
  "manifest_version": 3,
  "name": "yt_dex",
  "version": "1.0.0",
  "description": "YouTubeのサイドバーの登録チャンネルをグループ分けし、登録チャンネルフィードをタブ・グループで絞り込んで見やすくする拡張",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "common.js",
        "sidebar.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "common.js",
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
